root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_size = 4
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

# Generated EF Core migrations
[src/Pspsps.Infrastructure/Migrations/**.cs]
generated_code = true

# Test names read as sentences: Method_DoesWhat.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
# Performance and locale rules for production code: in tests, inline expected arrays and plain logging calls read
# better, and they run under a fixed invariant culture in CI.
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1848.severity = none
