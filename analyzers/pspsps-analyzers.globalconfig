# Not generated (sonar-rules.sh writes the sonar-*.globalconfig files): pspsps's own analyzers (Pspsps.Analyzers) are errors.
is_global = true

# PSPS001: no query (IQueryable) run synchronously in async code: ToListAsync and the other async operators, or
# AsAsyncEnumerable with await foreach
dotnet_diagnostic.PSPS001.severity = error
