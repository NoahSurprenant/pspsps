{
  // Console (compact JSON) and, when OTEL_EXPORTER_OTLP_ENDPOINT is set, OTLP are added in code
  // (Telemetry/LoggingExtensions.cs). Sinks added here come on top; don't add Console, it would print twice.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Pspsps": "Information",
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Orleans": "Warning",
        "Serilog.AspNetCore.RequestLoggingMiddleware": "Information"
      }
    }
  },
  "HealthChecks": {
    "Path": "/health",
    "LivePath": "/health/live",
    "ReadyPath": "/health/ready",
    // Managed memory above this reports Degraded. Size it at about 75% of the container's memory limit.
    "MaxAllocatedMegabytes": 384
  },
  "ForwardedHeaders": {
    // Fetch Cloudflare's published ranges at startup and trust them, to walk X-Forwarded-For past the
    // Cloudflare edge. Off: behind a proxy that already resolved the client (X-Real-IP), it isn't needed.
    "FetchCloudflare": false,
    "CloudflareIpsV4Url": "https://www.cloudflare.com/ips-v4/",
    "CloudflareIpsV6Url": "https://www.cloudflare.com/ips-v6/"
  },
  "AllowedHosts": "*"
}
